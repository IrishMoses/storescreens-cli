import XCTest

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// IMPORTANT: Accessibility Identifiers
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//
// This test relies on .accessibilityIdentifier() to find UI elements reliably.
// Add identifiers to your SwiftUI views - especially:
//
//   ✓ Buttons, toolbar items, and navigation elements
//   ✓ Loading indicators (ProgressView) and content containers
//   ✓ Text that appears in multiple places (e.g. your app name in both
//     the launch screen AND the main toolbar - using text matching will
//     cause false positives)
//   ✓ Search fields, text fields, toggles, pickers
//   ✓ Key content areas that indicate a screen has finished loading
//
// Example (SwiftUI):
//   Button("Save") { ... }
//     .accessibilityIdentifier("saveButton")
//
//   ProgressView()
//     .accessibilityIdentifier("loadingIndicator")
//
//   ScrollView { ... }
//     .accessibilityIdentifier("mainContent")
//
// Why: Matching by text label (e.g. app.staticTexts["My App"]) is fragile -
// the same text can appear in multiple views (launch screen, toolbar, about
// page). Accessibility identifiers are unique, stable, and testable.
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

final class ScreenshotTests: XCTestCase {

    private var app: XCUIApplication!
    private var captureSettings: [String: Any] = [:]

    override func setUpWithError() throws {
        continueAfterFailure = false
        app = XCUIApplication()
        let hostHome = ProcessInfo.processInfo.environment["SIMULATOR_HOST_HOME"] ?? NSHomeDirectory()
        let settingsPath = (hostHome as NSString).appendingPathComponent(".storescreens-cache/harness.json")
        let settings = (try? Data(contentsOf: URL(fileURLWithPath: settingsPath)))
            .flatMap { try? JSONSerialization.jsonObject(with: $0) as? [String: Any] } ?? [:]
        captureSettings = settings
        app.launchArguments = settings["launch_arguments"] as? [String] ?? ["--uitesting"]
        if let locale = settings["locale"] as? String, !locale.isEmpty {
            let parts = locale.split(separator: "-")
            let hasScript = parts.count > 1 && parts[1].count == 4
            let language = hasScript ? parts.prefix(2).joined(separator: "-") : String(parts[0])
            app.launchArguments += ["-AppleLanguages", "(\(language))", "-AppleLocale", locale.replacingOccurrences(of: "-", with: "_")]
        }
        app.launch()

        // Dismiss any system alerts (e.g. App Store review prompts, notification permissions)
        if settings["dismiss_system_alerts"] as? Bool != false {
        addUIInterruptionMonitor(withDescription: "System Alert") { alert in
            let dismissLabels = ["Not Now", "Cancel", "No Thanks", "Later", "Don't Allow", "OK"]
            for label in dismissLabels {
                let button = alert.buttons[label]
                if button.exists {
                    button.tap()
                    return true
                }
            }
            return false
        }

        }

        // TODO: Wait for your app's main content to load.
        // Use a unique accessibility identifier - NOT text that might appear on
        // a launch screen or splash screen. For example:
        //
        //   XCTAssertTrue(
        //     app.buttons["mainMenuButton"].waitForExistence(timeout: 15),
        //     "App did not finish loading"
        //   )
    }

    // MARK: - Helpers

    /// Check if a screenshot should be captured based on the --only filter.
    /// Returns true if no filter file exists (capture all) or if the name matches any filter prefix.
    private func shouldCapture(named name: String) -> Bool {
        let hostHome = ProcessInfo.processInfo.environment["SIMULATOR_HOST_HOME"]
            ?? ProcessInfo.processInfo.environment["HOME"]
            ?? NSHomeDirectory()
        let filterPath = (hostHome as NSString)
            .appendingPathComponent(".storescreens-cache/screenshot-filter.txt")

        guard let filterContent = try? String(contentsOfFile: filterPath, encoding: .utf8) else {
            return true // No filter file = capture all
        }

        let prefixes = filterContent.components(separatedBy: .newlines)
            .map { $0.trimmingCharacters(in: .whitespaces) }
            .filter { !$0.isEmpty }

        if prefixes.isEmpty { return true }

        return prefixes.contains { name.hasPrefix($0) || name.contains($0) }
    }

    private func takeScreenshot(named name: String) {
        let hostHomeForFilter = ProcessInfo.processInfo.environment["SIMULATOR_HOST_HOME"] ?? NSHomeDirectory()
        let filterPath = (hostHomeForFilter as NSString).appendingPathComponent(".storescreens-cache/screenshot-filter.txt")
        if let filter = try? String(contentsOfFile: filterPath, encoding: .utf8) {
            let prefixes = filter.split(separator: "\n").map(String.init)
            if !prefixes.isEmpty && !prefixes.contains(where: { name.hasPrefix($0) || name.contains($0) }) { return }
        }
        guard shouldCapture(named: name) else {
            print("[⏭️] \(name) (skipped by --only filter)")
            return
        }
        print("[📸] \(name)")
        let screenshot = XCUIScreen.main.screenshot()

        // 1. XCTAttachment (stored in .xcresult as backup)
        let attachment = XCTAttachment(screenshot: screenshot)
        attachment.name = name
        attachment.lifetime = .keepAlways
        add(attachment)

        // 2. Write PNG to storescreens cache dir for filesystem-based capture
        let hostHome = ProcessInfo.processInfo.environment["SIMULATOR_HOST_HOME"]
            ?? ProcessInfo.processInfo.environment["HOME"]
            ?? NSHomeDirectory()
        let breadcrumb = (hostHome as NSString).appendingPathComponent(".storescreens-cache-dir")
        guard let cacheDir = try? String(contentsOfFile: breadcrumb, encoding: .utf8)
            .trimmingCharacters(in: .whitespacesAndNewlines) else { return }

        // Strip "Clone N of " prefix - xcodebuild creates clones for parallel test runs,
        // but storescreens-cli expects the original simulator name as the directory key.
        var deviceName = ProcessInfo.processInfo.environment["SIMULATOR_DEVICE_NAME"] ?? (captureSettings["mac_device_name"] as? String) ?? "Unknown"
        if let range = deviceName.range(of: #"^Clone \d+ of "#, options: .regularExpression) {
            deviceName = String(deviceName[range.upperBound...])
        }
        let deviceDir = (cacheDir as NSString).appendingPathComponent(deviceName)
        try? FileManager.default.createDirectory(atPath: deviceDir, withIntermediateDirectories: true)

        let filePath = (deviceDir as NSString).appendingPathComponent("\(name).png")
        try? screenshot.pngRepresentation.write(to: URL(fileURLWithPath: filePath))
    }

    /// Wait for any element with the given accessibility identifier to appear.
    /// Use this instead of sleep() to wait for content to load.
    private func waitForElement(id: String, timeout: TimeInterval = 10, description: String? = nil) {
        let predicate = NSPredicate(format: "identifier == %@", id)
        let query = app.descendants(matching: .any).matching(predicate).firstMatch
        let desc = description ?? "Element '\(id)'"
        XCTAssertTrue(
            query.waitForExistence(timeout: timeout),
            "\(desc) not found within \(Int(timeout))s"
        )
    }

    // MARK: - App Store Screenshot Flow

    func testGenerateAppStoreScreenshots() throws {
{{SCREENSHOT_CALLS}}    }
}

// MARK: - Tips
//
// Reliable element targeting - use accessibility identifiers:
//   In SwiftUI:   .accessibilityIdentifier("myButton")
//   In UIKit:     view.accessibilityIdentifier = "myButton"
//   In XCUITest:  app.buttons["myButton"].tap()
//
// Wait for elements before tapping:
//   let el = app.buttons["Submit"]
//   XCTAssertTrue(el.waitForExistence(timeout: 5))
//   el.tap()
//
// Common interactions:
//   app.scrollViews.firstMatch.swipeUp()          // scroll down
//   app.swipeDown()                               // dismiss sheet
//   app.navigationBars.buttons.firstMatch.tap()   // back button
//   app.searchFields.firstMatch.tap()
//   app.typeText("search query")
//
// Screenshot mode - app setup (in app init or root .task):
//   if ProcessInfo.processInfo.arguments.contains("--uitesting") {
//       subscriptionService.isSubscribed = true
//       UIView.setAnimationsEnabled(false)
//   }
//
// Guard StoreKit / entitlement checks - wrap just the specific call, not the whole function.
// Using guard...return at the top of a function is dangerous: it silently skips everything
// below it, including state setup like isInitialized = true.
//   if !ProcessInfo.processInfo.arguments.contains("--uitesting") {
//       checkEntitlements()
//   }
